{
  "schemaVersion": 1,
  "id": "hqtiers",
  "version": "${version}",
  "name": "HQTiers",
  "description": "Tier Tagger built by a member of the server's staff team",
  "authors": [
    "micahcode"
  ],
  "contact": {
